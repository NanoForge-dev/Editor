{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@nanoforge-dev/editor",
  "version": "0.1.5",
  "description": "NanoForge Editor",
  "keywords": [
    "nanoforge",
    "game",
    "editor"
  ],
  "homepage": "https://github.com/NanoForge-dev/Editor#readme",
  "bugs": "https://github.com/NanoForge-dev/Editor/issues",
  "license": "MIT",
  "contributors": [
    "Exelo <contact@exelo.dev>",
    "Fexkoser <martin.fillon@epitech.eu>",
    "Harper <timothe.jacquot@epitech.eu>",
    "Josephine <josephine.chicouras@epitech.eu>",
    "Leo <leo.outmizguine@epitech.eu>"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    "./package.json": "./package.json"
  },
  "type": "module",
  "directories": {
    "lib": "src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NanoForge-dev/Editor.git",
    "directory": "apps/editor"
  },
  "funding": "https://github.com/NanoForge-dev/Editor?sponsor",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && bun ./scripts/build-server.ts",
    "preview": "bun ./dist/index.js",
    "start": "bun ./dist/index.js",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p server/tsconfig.json",
    "lint": "prettier --check . && eslint --format=pretty src",
    "format": "prettier --write . && eslint --fix --format=pretty src",
    "test:unit": "vitest run --config ../../vitest.config.ts",
    "changelog": "git cliff --prepend ./CHANGELOG.md -u -c ./cliff.toml -r ../../ --include-path 'apps/editor/*' --include-path 'packages/*' --include-path 'plugins/*'",
    "release": "cliff-jumper",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "chokidar": "catalog:server",
    "prettier": "catalog:server",
    "typescript": "catalog:build",
    "unrun": "catalog:build",
    "yaml": "catalog:server"
  },
  "devDependencies": {
    "@favware/cliff-jumper": "catalog:ci",
    "@nanoforge-dev/editor-code": "workspace:*",
    "@nanoforge-dev/editor-history": "workspace:*",
    "@nanoforge-dev/editor-kernel": "workspace:*",
    "@nanoforge-dev/editor-layout": "workspace:*",
    "@nanoforge-dev/editor-plugin-code-editor": "workspace:*",
    "@nanoforge-dev/editor-plugin-command-palette": "workspace:*",
    "@nanoforge-dev/editor-plugin-console": "workspace:*",
    "@nanoforge-dev/editor-plugin-ecs": "workspace:*",
    "@nanoforge-dev/editor-plugin-file-manager": "workspace:*",
    "@nanoforge-dev/editor-plugin-git": "workspace:*",
    "@nanoforge-dev/editor-plugin-history-panel": "workspace:*",
    "@nanoforge-dev/editor-plugin-inspectors": "workspace:*",
    "@nanoforge-dev/editor-plugin-packages": "workspace:*",
    "@nanoforge-dev/editor-plugin-scene": "workspace:*",
    "@nanoforge-dev/editor-plugin-settings-ui": "workspace:*",
    "@nanoforge-dev/editor-plugin-viewport": "workspace:*",
    "@nanoforge-dev/editor-project": "workspace:*",
    "@nanoforge-dev/editor-protocol": "workspace:*",
    "@nanoforge-dev/editor-rpc": "workspace:*",
    "@nanoforge-dev/editor-runtime": "workspace:*",
    "@nanoforge-dev/editor-sdk": "workspace:*",
    "@nanoforge-dev/editor-server-core": "workspace:*",
    "@nanoforge-dev/editor-settings": "workspace:*",
    "@nanoforge-dev/editor-ui": "workspace:*",
    "@nanoforge-dev/editor-vite-plugin": "workspace:*",
    "@playwright/test": "catalog:test",
    "@sveltejs/adapter-static": "catalog:adapter",
    "@sveltejs/kit": "catalog:core",
    "@sveltejs/vite-plugin-svelte": "catalog:core",
    "@types/bun": "catalog:core",
    "playwright": "catalog:test",
    "svelte": "catalog:core",
    "svelte-check": "catalog:core",
    "typescript": "catalog:build",
    "vite": "catalog:core",
    "vitest": "catalog:test",
    "zod": "catalog:libs"
  },
  "packageManager": "pnpm@12.0.0",
  "engines": {
    "node": "26"
  },
  "publishConfig": {
    "access": "public"
  },
  "lint-staged": {
    "**": [
      "prettier --ignore-unknown --write"
    ],
    "**/*.{ts,svelte}": [
      "eslint --fix"
    ]
  }
}
