{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "const": "plugin"
    },
    "name": {
      "type": "string",
      "pattern": "^@[a-z0-9][a-z0-9-]*\\/[a-z0-9][a-z0-9-]*$"
    },
    "version": {
      "type": "string"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "keywords": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "icon": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "engines": {
      "type": "object",
      "properties": {
        "editor": {
          "type": "string"
        }
      },
      "required": ["editor"]
    },
    "dependencies": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^@[a-z0-9][a-z0-9-]*\\/[a-z0-9][a-z0-9-]*$"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^@[a-z0-9][a-z0-9-]*\\/[a-z0-9][a-z0-9-]*$"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      ]
    },
    "optionalDependencies": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^@[a-z0-9][a-z0-9-]*\\/[a-z0-9][a-z0-9-]*$"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^@[a-z0-9][a-z0-9-]*\\/[a-z0-9][a-z0-9-]*$"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      ]
    },
    "engineLibs": {
      "default": {
        "required": {},
        "optional": {}
      },
      "type": "object",
      "properties": {
        "required": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "optional": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "entry": {
      "default": {},
      "type": "object",
      "properties": {
        "client": {
          "type": "string",
          "minLength": 1
        },
        "server": {
          "type": "string",
          "minLength": 1
        },
        "worker": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "activation": {
      "default": ["onStartup"],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(onStartup|on(Command|Screen|Widget|ProjectType|Language|Uri):.+)$"
      }
    },
    "contributes": {
      "default": {
        "commands": []
      },
      "type": "object",
      "properties": {
        "commands": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "category": {
                "type": "string"
              },
              "icon": {
                "type": "string"
              },
              "when": {
                "type": "string"
              },
              "palette": {
                "type": "boolean"
              }
            },
            "required": ["id", "title"]
          }
        },
        "itemOwner": {
          "type": "object",
          "properties": {
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "tags": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][A-Za-z0-9]*$"
              }
            }
          },
          "required": ["schema"]
        },
        "themes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[\\w-]+$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": ["dark", "light"]
              },
              "extends": {
                "type": "string"
              },
              "colors": {
                "default": {},
                "type": "object",
                "properties": {
                  "bg": {
                    "type": "string",
                    "minLength": 1
                  },
                  "surface": {
                    "type": "string",
                    "minLength": 1
                  },
                  "raised": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sunken": {
                    "type": "string",
                    "minLength": 1
                  },
                  "hover": {
                    "type": "string",
                    "minLength": 1
                  },
                  "pressed": {
                    "type": "string",
                    "minLength": 1
                  },
                  "border": {
                    "type": "string",
                    "minLength": 1
                  },
                  "border-strong": {
                    "type": "string",
                    "minLength": 1
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "text-muted": {
                    "type": "string",
                    "minLength": 1
                  },
                  "text-faint": {
                    "type": "string",
                    "minLength": 1
                  },
                  "accent": {
                    "type": "string",
                    "minLength": 1
                  },
                  "accent-hover": {
                    "type": "string",
                    "minLength": 1
                  },
                  "on-accent": {
                    "type": "string",
                    "minLength": 1
                  },
                  "accent-text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "focus": {
                    "type": "string",
                    "minLength": 1
                  },
                  "selection": {
                    "type": "string",
                    "minLength": 1
                  },
                  "selection-text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "danger": {
                    "type": "string",
                    "minLength": 1
                  },
                  "warning": {
                    "type": "string",
                    "minLength": 1
                  },
                  "success": {
                    "type": "string",
                    "minLength": 1
                  },
                  "scrim": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              },
              "syntax": {
                "type": "object",
                "properties": {
                  "keyword": {
                    "type": "string",
                    "minLength": 1
                  },
                  "string": {
                    "type": "string",
                    "minLength": 1
                  },
                  "number": {
                    "type": "string",
                    "minLength": 1
                  },
                  "comment": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type": {
                    "type": "string",
                    "minLength": 1
                  },
                  "variable": {
                    "type": "string",
                    "minLength": 1
                  },
                  "regexp": {
                    "type": "string",
                    "minLength": 1
                  },
                  "delimiter": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              },
              "tokens": {
                "type": "object",
                "properties": {
                  "font-ui": {
                    "type": "string",
                    "minLength": 1
                  },
                  "font-code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "radius-control": {
                    "type": "string",
                    "minLength": 1
                  },
                  "radius-float": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              }
            },
            "required": ["id", "label"],
            "additionalProperties": false
          }
        },
        "icons": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][\\w-]*$"
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["id", "path"],
            "additionalProperties": false
          }
        },
        "iconThemes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[\\w-]+$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "icons": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-z0-9][\\w-]*$"
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "files": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "pattern": {
                      "type": "string",
                      "minLength": 1
                    },
                    "icon": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["pattern", "icon"],
                  "additionalProperties": false
                }
              },
              "folders": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "pattern": {
                      "type": "string",
                      "minLength": 1
                    },
                    "icon": {
                      "type": "string",
                      "minLength": 1
                    },
                    "iconOpen": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["pattern", "icon"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["id", "label"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": {}
    },
    "build": {
      "default": {},
      "type": "object",
      "properties": {
        "svelte": {
          "type": "string"
        },
        "sdk": {
          "type": "string"
        }
      }
    }
  },
  "required": ["type", "name", "version", "engines"]
}
