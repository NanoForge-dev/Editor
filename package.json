{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@nanoforge-dev/editor-workspace",
  "version": "0.0.0",
  "description": "NanoForge Editor monorepo",
  "homepage": "https://github.com/NanoForge-dev/Editor#readme",
  "bugs": "https://github.com/NanoForge-dev/Editor/issues",
  "license": "MIT",
  "contributors": [
    "Exelo <contact@exelo.dev>",
    "Fexkoser <martin.fillon@epitech.eu>",
    "Harper <timothe.jacquot@epitech.eu>",
    "Josephine <josephine.chicouras@epitech.eu>",
    "Leo <leo.outmizguine@epitech.eu>"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NanoForge-dev/Editor.git"
  },
  "funding": "https://github.com/NanoForge-dev/Editor?sponsor",
  "scripts": {
    "dev": "turbo run dev --filter=@nanoforge-dev/editor --filter='./plugins/*'",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "prettier --check . && node scripts/check-workspaces.mjs && knip --no-progress --no-config-hints && eslint --format=pretty scripts commitlint.config.cjs vitest.setup.ts vitest.global-setup.ts && turbo run lint",
    "format": "prettier --write . && turbo run format",
    "test": "pnpm run test:unit",
    "test:unit": "turbo run test:unit",
    "test:coverage": "turbo run test:coverage",
    "e2e:last-failure": "pnpm --filter @nanoforge-dev/editor e2e:last-failure",
    "example": "node scripts/example.mjs",
    "setup:check": "node scripts/setup-check.mjs",
    "setup:engine": "node scripts/setup-engine.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:ci",
    "@commitlint/config-conventional": "catalog:ci",
    "@nanoforge-dev/actions": "catalog:ci",
    "@nanoforge-dev/utils-eslint-config": "catalog:lint",
    "@nanoforge-dev/utils-prettier-config": "catalog:lint",
    "@trivago/prettier-plugin-sort-imports": "catalog:lint",
    "@types/node": "catalog:core",
    "@vitest/coverage-v8": "catalog:test",
    "eslint": "catalog:lint",
    "eslint-plugin-svelte": "catalog:lint",
    "globals": "catalog:lint",
    "husky": "catalog:ci",
    "knip": "catalog:lint",
    "lint-staged": "catalog:ci",
    "prettier": "catalog:lint",
    "prettier-plugin-svelte": "catalog:lint",
    "svelte": "catalog:core",
    "turbo": "catalog:build",
    "typescript": "catalog:build",
    "typescript-eslint": "catalog:lint",
    "vitest": "catalog:test"
  },
  "packageManager": "pnpm@12.0.0",
  "engines": {
    "node": "26"
  },
  "private": true,
  "lint-staged": {
    "**": [
      "prettier --ignore-unknown --write"
    ]
  }
}
