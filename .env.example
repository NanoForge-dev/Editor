# production | development
NODE_ENV=development

# OFFLINE: local projects on disk (binds to 127.0.0.1). ONLINE: hosted, projects synced with git gateways.
PUBLIC_MODE=OFFLINE

# Server
# HOST=127.0.0.1
PORT=3000

# Projects must live under this directory (default: current directory)
FS_ROOT=
# Editor data (recent projects, installed plugins). Default: ~/.nanoforge/editor
DATA_DIR=

# NanoForge API (API_KEY required when PUBLIC_MODE=ONLINE)
API_URL=https://api.nanoforge.eu
API_KEY=
# Where ONLINE users sign in (the website sets the auth cookies)
PUBLIC_PM_URL=https://projects.nanoforge.eu

# Leave empty to generate a random secret at start (sessions are lost on restart)
SESSION_SECRET=

# Change if the binaries are not in the PATH (nf: the project's own node_modules/.bin is tried first)
NF_CLI_PATH=
GIT_PATH=

# Comma separated list of local plugin folders under development (their dist/ is served, hot reloaded)
DEV_PLUGINS=
# Extra origins allowed to call the server (reverse proxies)
ALLOWED_ORIGINS=
