{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@nanoforge-dev/editor-vite-plugin",
  "version": "0.0.0",
  "description": "NanoForge Editor - Vite plugin to build editor plugins against the host's shared modules",
  "keywords": [
    "nanoforge",
    "game",
    "editor"
  ],
  "homepage": "https://github.com/NanoForge-dev/Editor#readme",
  "bugs": "https://github.com/NanoForge-dev/Editor/issues",
  "license": "MIT",
  "contributors": [
    "Exelo <contact@exelo.dev>",
    "Fexkoser <martin.fillon@epitech.eu>",
    "Harper <timothe.jacquot@epitech.eu>",
    "Josephine <josephine.chicouras@epitech.eu>",
    "Leo <leo.outmizguine@epitech.eu>"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "type": "module",
  "directories": {
    "lib": "src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NanoForge-dev/Editor.git",
    "directory": "tooling/vite-plugin"
  },
  "funding": "https://github.com/NanoForge-dev/Editor?sponsor",
  "scripts": {
    "build": "tsdown",
    "lint": "prettier --check . && eslint --format=pretty src",
    "format": "prettier --write . && eslint --fix --format=pretty src",
    "typecheck": "tsc -p tsconfig.json",
    "test:unit": "vitest run --config ../../vitest.config.ts",
    "changelog": "git cliff --prepend ./CHANGELOG.md -u -c ./cliff.toml -r ../../ --include-path 'tooling/vite-plugin/*'",
    "release": "cliff-jumper"
  },
  "dependencies": {
    "es-module-lexer": "catalog:tooling",
    "semver": "catalog:libs",
    "zod": "catalog:libs"
  },
  "peerDependencies": {
    "vite": ">=7"
  },
  "devDependencies": {
    "@favware/cliff-jumper": "catalog:ci",
    "@nanoforge-dev/editor-kernel": "workspace:*",
    "@types/node": "catalog:core",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vite": "catalog:core",
    "vitest": "catalog:test"
  },
  "packageManager": "pnpm@12.0.0",
  "engines": {
    "node": "26"
  },
  "private": true,
  "lint-staged": {
    "**": [
      "prettier --ignore-unknown --write"
    ],
    "**/*.ts": [
      "eslint --fix"
    ]
  }
}
