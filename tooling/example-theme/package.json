{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@nanoforge-dev/editor-example-theme",
  "version": "0.0.0",
  "description": "NanoForge Editor - Example theme plugin (a theme, icons and an icon theme, with no code)",
  "keywords": [
    "nanoforge",
    "game",
    "editor",
    "plugin",
    "theme"
  ],
  "homepage": "https://github.com/NanoForge-dev/Editor#readme",
  "bugs": "https://github.com/NanoForge-dev/Editor/issues",
  "license": "MIT",
  "contributors": [
    "Exelo <contact@exelo.dev>",
    "Fexkoser <martin.fillon@epitech.eu>",
    "Harper <timothe.jacquot@epitech.eu>",
    "Josephine <josephine.chicouras@epitech.eu>",
    "Leo <leo.outmizguine@epitech.eu>"
  ],
  "type": "module",
  "directories": {
    "lib": "src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NanoForge-dev/Editor.git",
    "directory": "tooling/example-theme"
  },
  "funding": "https://github.com/NanoForge-dev/Editor?sponsor",
  "scripts": {
    "build": "node build.mjs",
    "lint": "prettier --check .",
    "format": "prettier --write ."
